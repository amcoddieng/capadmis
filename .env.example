NODE_ENV=production
PORT=3000
POSTGRES_DB=capadmis
POSTGRES_USER=capadmis
POSTGRES_PASSWORD=changez_ce_mot_de_passe
DATABASE_URL=postgresql://capadmis:changez_ce_mot_de_passe@db:5432/capadmis?schema=public
JWT_SECRET=generez_une_longue_cle_aleatoire
REFRESH_SECRET=generez_une_autre_longue_cle_aleatoire

# Gmail SMTP
# Utiliser un "App Password" Google (pas votre vrai mot de passe)
# Activer : https://myaccount.google.com/apppasswords
GMAIL_USER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Cloudflare R2
# Dashboard R2 → Manage R2 API tokens pour ACCESS_KEY et SECRET_KEY
R2_ACCOUNT_ID=votre_account_id
R2_ACCESS_KEY_ID=votre_access_key_id
R2_SECRET_ACCESS_KEY=votre_secret_access_key
R2_BUCKET_NAME=capadmis-files
